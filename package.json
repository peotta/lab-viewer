{
  "name": "lab-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "Visualizador de roteiros de laboratório em Markdown (UnB)",
  "type": "module",
  "scripts": {
    "prepare:labs": "node scripts/prepare.mjs",
    "dev": "npm run prepare:labs && vite",
